# Every environment variable used in this repo. Real values live in gitignored .env files.
# apps/cms/.env.local is generated for local development by `npm run env:local`.
# apps/mobile/.env is copied by hand from apps/mobile/.env.example.

# CMS and API (apps/cms)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public base for audio and images. Defaults to SUPABASE_URL/storage/v1/object/public/media.
# For a phone on Wi-Fi in development, use your laptop LAN address here.
PUBLIC_MEDIA_BASE_URL=
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_PROFILE=foot
RATE_LIMIT_SALT=
RATE_LIMIT_MAX_PER_MINUTE=30
APP_VERSION=0.1.0
# Local seed admin (content manager) created by `npm run seed`
SEED_ADMIN_EMAIL=admin@singalore.local
SEED_ADMIN_PASSWORD=

# Mobile app (apps/mobile), see apps/mobile/.env.example
APP_VARIANT=development
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_DEBUG_TOOLS=1
EXPO_PUBLIC_SATELLITE_TILE_URL=
EXPO_PUBLIC_SENTRY_DSN=

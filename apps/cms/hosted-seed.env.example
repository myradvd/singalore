# Copy to apps/cms/.env.hosted (gitignored), fill in, then run `npm run seed:hosted` from the repo root.
# Values come from Supabase: Project Settings > API. Never commit the filled-in file.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The content manager account for the hosted CMS. Use your own email and a password of 12 or more characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

{
  "cli": {
    "version": ">= 24.12.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_DEBUG_TOOLS": "1" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_DEBUG_TOOLS": "1" }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_DEBUG_TOOLS": "0" }
    }
  }
}

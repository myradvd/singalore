# Optional. You do not need an apps/mobile/.env file to develop: the app uses the shared hosted
# backend set in apps/mobile/config/hostedProject.ts. Copy this file to apps/mobile/.env only to
# override something, for example to use a local backend. Never commit .env.

# development | preview | production (EAS profiles set this for you)
APP_VARIANT=development
# Uncomment to use a local backend instead of the hosted one:
# http://10.0.2.2:3000 for the Android emulator, or your laptop's LAN address for a phone on the same Wi-Fi.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Vector map style. Defaults to OpenFreeMap Positron.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# 1 enables the hidden developer tools (development and preview), must be 0 for production.
EXPO_PUBLIC_DEBUG_TOOLS=1
# Optional XYZ raster tile URL template for the Satellite layer. Leave empty to hide that layer.
EXPO_PUBLIC_SATELLITE_TILE_URL=
# Optional Sentry DSN. Crash reporting stays off when empty.
EXPO_PUBLIC_SENTRY_DSN=

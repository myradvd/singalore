# Copy to apps/mobile/.env for local development. Never commit .env.
# development | preview | production (EAS profiles set this for you)
APP_VARIANT=development
# Development: your laptop's LAN address so a phone on the same Wi-Fi can reach `npm run dev:cms`,
# or http://10.0.2.2:3000 for the Android emulator. Preview and production builds require a public https URL.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
# Vector map style. Defaults to OpenFreeMap Positron.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# 1 enables the hidden developer tools (development and preview), must be 0 for production.
EXPO_PUBLIC_DEBUG_TOOLS=1
# Optional XYZ raster tile URL template for the Satellite layer. Leave empty to hide that layer.
EXPO_PUBLIC_SATELLITE_TILE_URL=
# Optional Sentry DSN. Crash reporting stays off when empty.
EXPO_PUBLIC_SENTRY_DSN=
